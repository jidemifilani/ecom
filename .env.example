# ──────────────────────────────────────────────────────────────────────────────
# Ecom — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# Runtime -----------------------------------------------------------------
NODE_ENV=development
# Public origin of the app. Used for absolute links (password-reset emails,
# OAuth redirect URIs) and for same-origin CSRF checks.
APP_URL=http://localhost:3000

# Database ----------------------------------------------------------------
# PostgreSQL connection string. `docker compose up -d` provisions this locally.
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5435/ecom?schema=public

# Secrets -----------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to sign CSRF tokens and hash single-use reset tokens at rest.
AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness

# Session -----------------------------------------------------------------
# Idle + absolute session lifetimes, in seconds.
SESSION_IDLE_TIMEOUT_SECONDS=2592000
SESSION_ABSOLUTE_TIMEOUT_SECONDS=7776000

# Password policy ---------------------------------------------------------
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12

# Brute-force protection --------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Optional: Microsoft Entra ID (Azure AD) SSO -----------------------------
# Leave AUTH_ENTRA_ENABLED=false to run with email/password only.
AUTH_ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the app registration.
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback
# Only these email domains may be provisioned via SSO (comma-separated, blank = any).
ENTRA_ALLOWED_DOMAINS=

# Outbound email ----------------------------------------------------------
# Transport: `smtp` for real delivery, `log` to write messages to the server
# log instead (development only — the app refuses `log` in production).
MAIL_TRANSPORT=log
MAIL_FROM="Ecom <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Seeding -----------------------------------------------------------------
# The first super admin. The seed script refuses to run without these.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
# Set to `true` to also seed demo catalog/orders/customers (never in production).
SEED_DEMO_DATA=true

# Host port for the local Postgres container (5432-5434 are used by other
# projects on this machine; change freely).
POSTGRES_PORT=5435
