// ─────────────────────────────────────────────────────────────────────────────
// Ecom — PostgreSQL schema
//
// Conventions
//  * Primary keys are UUIDs generated by the database (gen_random_uuid).
//  * All money is stored as INTEGER MINOR UNITS (cents / kobo / pence) together
//    with an ISO-4217 currency code. This avoids float drift and Decimal
//    serialisation differences across the HTTP boundary. Format with
//    src/lib/money.ts; never do arithmetic on formatted strings.
//  * deletedAt marks a soft delete. Every query path that must hide archived
//    rows goes through the services in src/server/.
//  * createdById / updatedById reference the acting staff user where the
//    record can be mutated from the back office.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SessionScope {
  STAFF
  CUSTOMER
}

enum AuthProvider {
  LOCAL
  ENTRA_ID
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum PaymentProvider {
  MANUAL
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  DAMAGE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  CATEGORY
  PRODUCT
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ── Identity, access control & sessions ──────────────────────────────────────

/// Back-office operator. Storefront shoppers live in Customer.
model User {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-cased, so uniqueness is case-insensitive.
  email              String       @unique @db.VarChar(255)
  emailVerifiedAt    DateTime?
  firstName          String       @db.VarChar(100)
  lastName           String       @db.VarChar(100)
  phone              String?      @db.VarChar(32)
  avatarUrl          String?      @db.VarChar(2048)
  jobTitle           String?      @db.VarChar(120)
  /// Null for SSO-only accounts that have never set a local password.
  passwordHash       String?      @db.VarChar(255)
  passwordSetAt      DateTime?
  mustChangePassword Boolean      @default(false)
  status             UserStatus   @default(INVITED)
  authProvider       AuthProvider @default(LOCAL)
  /// Entra ID object id (oid), unique per tenant.
  externalId         String?      @unique @db.VarChar(255)
  locale             String       @default("en") @db.VarChar(16)
  timezone           String       @default("UTC") @db.VarChar(64)
  lastLoginAt        DateTime?
  lastLoginIp        String?      @db.VarChar(64)
  failedLoginCount   Int          @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  createdById        String?      @db.Uuid
  updatedById        String?      @db.Uuid

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updatedBy    User?  @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers User[] @relation("UserUpdatedBy")

  roles           UserRole[]           @relation("UserRoleUser")
  assignedRoles   UserRole[]           @relation("UserRoleAssignedBy")
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  orderEvents     OrderEvent[]
  refunds         Refund[]
  settingsUpdated Setting[]

  @@index([status])
  @@index([deletedAt])
  @@index([lastLoginAt])
  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key, e.g. super_admin. Never changes once shipped.
  key         String    @unique @db.VarChar(64)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  /// System roles cannot be deleted or re-keyed from the UI.
  isSystem    Boolean   @default(false)
  /// Lower number = more authority. Guards against privilege escalation.
  level       Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// resource.action, e.g. product.update
  key         String   @unique @db.VarChar(96)
  resource    String   @db.VarChar(48)
  action      String   @db.VarChar(48)
  /// UI grouping label, e.g. Catalog
  group       String   @db.VarChar(48)
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Opaque, server-side session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         String       @unique @db.VarChar(64)
  scope             SessionScope
  userId            String?      @db.Uuid
  customerId        String?      @db.Uuid
  ipAddress         String?      @db.VarChar(64)
  userAgent         String?      @db.VarChar(512)
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  /// Sliding idle expiry, refreshed on use.
  expiresAt         DateTime
  /// Hard ceiling; never extended.
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?      @db.VarChar(120)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use password reset token. Only the hash is persisted.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @db.Uuid
  customerId  String?   @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Every authentication attempt, successful or not. Drives lockout, rate
/// limiting and the security view of the audit log.
model LoginAttempt {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String       @db.VarChar(255)
  scope      SessionScope
  successful Boolean
  reason     String?      @db.VarChar(64)
  ipAddress  String?      @db.VarChar(64)
  userAgent  String?      @db.VarChar(512)
  createdAt  DateTime     @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

/// Generic fixed-window counter backing rate-limited endpoints.
model RateLimitCounter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// bucket:identifier, e.g. login:203.0.113.4
  key         String   @unique @db.VarChar(255)
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(180)
  logoUrl   String?   @db.VarChar(2048)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
  @@map("brands")
}

model Category {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @db.VarChar(160)
  slug           String    @unique @db.VarChar(180)
  description    String?
  imageUrl       String?   @db.VarChar(2048)
  parentId       String?   @db.Uuid
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  metaTitle      String?   @db.VarChar(200)
  metaDescription String?  @db.VarChar(320)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String        @db.VarChar(240)
  slug             String        @unique @db.VarChar(260)
  shortDescription String?       @db.VarChar(500)
  description      String?
  status           ProductStatus @default(DRAFT)
  categoryId       String?       @db.Uuid
  brandId          String?       @db.Uuid
  /// Default price in minor units; variants may override.
  basePrice        Int
  compareAtPrice   Int?
  costPrice        Int?
  currency         String        @default("USD") @db.VarChar(3)
  taxRateBps       Int           @default(0)
  isFeatured       Boolean       @default(false)
  trackInventory   Boolean       @default(true)
  weightGrams      Int?
  metaTitle        String?       @db.VarChar(200)
  metaDescription  String?       @db.VarChar(320)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  options    ProductOption[]
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(2048)
  alt       String   @db.VarChar(300)
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// A configurable axis, e.g. "Size".
model ProductOption {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @db.Uuid
  name      String @db.VarChar(80)
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId String @db.Uuid
  value    String @db.VarChar(80)
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

/// Every product has at least one variant; simple products get a single
/// default variant so inventory and order lines always resolve to a variant.
model ProductVariant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @db.Uuid
  sku            String    @unique @db.VarChar(80)
  barcode        String?   @db.VarChar(80)
  name           String    @db.VarChar(240)
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  weightGrams    Int?
  position       Int       @default(0)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues  VariantOptionValue[]
  inventoryItem InventoryItem?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  movements     StockMovement[]

  @@index([productId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

// ── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String   @unique @db.Uuid
  quantityOnHand    Int      @default(0)
  /// Held for unpaid orders; available = onHand - reserved.
  quantityReserved  Int      @default(0)
  reorderPoint      Int      @default(0)
  reorderQuantity   Int      @default(0)
  binLocation       String?  @db.VarChar(80)
  allowBackorder    Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantityOnHand])
  @@map("inventory_items")
}

/// Append-only ledger. Current stock is always reconstructable from this table.
model StockMovement {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId    String            @db.Uuid
  type         StockMovementType
  /// Signed: positive adds stock, negative removes it.
  quantity     Int
  balanceAfter Int
  reference    String?           @db.VarChar(80)
  reason       String?           @db.VarChar(300)
  createdById  String?           @db.Uuid
  createdAt    DateTime          @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([type])
  @@map("stock_movements")
}

// ── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String         @unique @db.VarChar(255)
  firstName          String         @db.VarChar(100)
  lastName           String         @db.VarChar(100)
  phone              String?        @db.VarChar(32)
  /// Null for guest checkouts that never created a password.
  passwordHash       String?        @db.VarChar(255)
  emailVerifiedAt    DateTime?
  status             CustomerStatus @default(ACTIVE)
  marketingOptIn     Boolean        @default(false)
  notes              String?
  failedLoginCount   Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  reviews       Review[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  redemptions   DiscountRedemption[]
  notifications Notification[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("customers")
}

model Address {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String   @db.Uuid
  label            String?  @db.VarChar(60)
  firstName        String   @db.VarChar(100)
  lastName         String   @db.VarChar(100)
  company          String?  @db.VarChar(160)
  line1            String   @db.VarChar(240)
  line2            String?  @db.VarChar(240)
  city             String   @db.VarChar(120)
  state            String?  @db.VarChar(120)
  postalCode       String?  @db.VarChar(32)
  countryCode      String   @db.VarChar(2)
  phone            String?  @db.VarChar(32)
  isDefaultShipping Boolean @default(false)
  isDefaultBilling Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ── Cart & checkout ──────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Opaque token stored in a cookie for guest carts.
  token      String     @unique @db.VarChar(64)
  customerId String?    @db.Uuid
  status     CartStatus @default(ACTIVE)
  currency   String     @default("USD") @db.VarChar(3)
  discountCode String?  @db.VarChar(48)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  /// Price snapshot so a mid-session price change is visible, not silent.
  unitPrice Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-facing sequential reference, e.g. ORD-100248.
  number            String            @unique @db.VarChar(32)
  customerId        String?           @db.Uuid
  /// Snapshot: an order keeps the address it was placed with.
  email             String            @db.VarChar(255)
  phone             String?           @db.VarChar(32)
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @db.VarChar(3)
  subtotal          Int
  discountTotal     Int               @default(0)
  taxTotal          Int               @default(0)
  shippingTotal     Int               @default(0)
  grandTotal        Int
  refundedTotal     Int               @default(0)
  discountCode      String?           @db.VarChar(48)
  channel           String            @default("web") @db.VarChar(32)
  customerNote      String?
  internalNote      String?
  ipAddress         String?           @db.VarChar(64)
  placedAt          DateTime          @default(now())
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  addresses   OrderAddress[]
  payments    Payment[]
  shipments   Shipment[]
  refunds     Refund[]
  events      OrderEvent[]
  redemptions DiscountRedemption[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([placedAt])
  @@index([email])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String  @db.Uuid
  /// Nullable: the catalogue may change, the order line must not.
  variantId     String? @db.Uuid
  productId     String? @db.Uuid
  productName   String  @db.VarChar(240)
  variantName   String  @db.VarChar(240)
  sku           String  @db.VarChar(80)
  unitPrice     Int
  quantity      Int
  discountTotal Int     @default(0)
  taxTotal      Int     @default(0)
  lineTotal     Int
  quantityFulfilled Int @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model OrderAddress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @db.Uuid
  /// SHIPPING or BILLING.
  type        String   @db.VarChar(16)
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  company     String?  @db.VarChar(160)
  line1       String   @db.VarChar(240)
  line2       String?  @db.VarChar(240)
  city        String   @db.VarChar(120)
  state       String?  @db.VarChar(120)
  postalCode  String?  @db.VarChar(32)
  countryCode String   @db.VarChar(2)
  phone       String?  @db.VarChar(32)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

model Payment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String          @db.Uuid
  provider   PaymentProvider
  reference  String?         @db.VarChar(120)
  amount     Int
  currency   String          @db.VarChar(3)
  status     PaymentStatus
  capturedAt DateTime?
  failureReason String?      @db.VarChar(300)
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @db.Uuid
  carrier        String         @db.VarChar(80)
  trackingNumber String?        @db.VarChar(120)
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model Refund {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @db.Uuid
  amount      Int
  currency    String   @db.VarChar(3)
  reason      String   @db.VarChar(300)
  restock     Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

/// Status-tracking timeline shown on the order detail page.
model OrderEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @db.Uuid
  type        String   @db.VarChar(48)
  message     String   @db.VarChar(500)
  metadata    Json?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ── Promotions ───────────────────────────────────────────────────────────────

model Discount {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String        @unique @db.VarChar(48)
  name             String        @db.VarChar(160)
  description      String?       @db.VarChar(500)
  type             DiscountType
  scope            DiscountScope @default(ALL)
  /// Percentage in basis points (1000 = 10%) or a fixed amount in minor units.
  value            Int
  minSubtotal      Int           @default(0)
  maxDiscountAmount Int?
  usageLimit       Int?
  usageCount       Int           @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean       @default(true)
  targetCategoryId String?       @db.Uuid
  targetProductId  String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  createdById      String?       @db.Uuid

  redemptions DiscountRedemption[]

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("discounts")
}

model DiscountRedemption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discountId String   @db.Uuid
  orderId    String   @db.Uuid
  customerId String?  @db.Uuid
  amount     Int
  createdAt  DateTime @default(now())

  discount Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([discountId, orderId])
  @@index([customerId])
  @@map("discount_redemptions")
}

// ── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String       @db.Uuid
  customerId  String?      @db.Uuid
  authorName  String       @db.VarChar(120)
  rating      Int
  title       String?      @db.VarChar(200)
  body        String
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

// ── Platform: notifications, audit, settings ─────────────────────────────────

model Notification {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exactly one recipient is set.
  userId     String?           @db.Uuid
  customerId String?           @db.Uuid
  type       String            @db.VarChar(64)
  level      NotificationLevel @default(INFO)
  title      String            @db.VarChar(200)
  body       String            @db.VarChar(1000)
  entityType String?           @db.VarChar(48)
  entityId   String?           @db.Uuid
  actionUrl  String?           @db.VarChar(512)
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([customerId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Append-only. Never updated or deleted by application code.
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @db.Uuid
  /// Email captured at the time of the action, so the trail survives deletion.
  actorEmail   String?  @db.VarChar(255)
  actorType    String   @default("USER") @db.VarChar(16)
  action       String   @db.VarChar(64)
  entityType   String   @db.VarChar(48)
  entityId     String?  @db.VarChar(64)
  entityLabel  String?  @db.VarChar(240)
  /// Field-level diff; secrets are redacted before writing.
  before       Json?
  after        Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(512)
  requestId    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String      @unique @db.VarChar(96)
  group       String      @db.VarChar(48)
  label       String      @db.VarChar(160)
  description String?     @db.VarChar(400)
  type        SettingType @default(STRING)
  value       Json
  /// Secret values are never returned to the client in full.
  isSecret    Boolean     @default(false)
  updatedById String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("settings")
}

/// Monotonic counters for human-facing references (order numbers).
model Counter {
  key   String @id @db.VarChar(48)
  value Int    @default(0)

  @@map("counters")
}
